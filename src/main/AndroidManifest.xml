<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A launcher sees every app you open, so it must never reach the network.
         tools:node="remove" strips INTERNET even if a library declares it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Swipe down opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- "Desinstalar" in app menus. Android still asks before removing anything. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- A launcher has to see every app: launcher icons, and widget providers whose receiver is not
         exported (a <queries> intent misses those). Harmless here: nothing can leave the device. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Blocks: lets the app turn its blocking service back on when it was turned off, and keep the time automatic
         during a block. Only adb can grant it (scripts/blocks-setup.sh); without it there are no blocks. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <activity
            android:name=".Launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Add to home screen" from other apps. Exported because the system starts it; a forged
             intent carries no valid PinItemRequest, so it does nothing. Its own task: with the launcher's affinity
             it joined the home task, which stays behind the app that asked, so the dialog was never seen. -->
        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- Blocks (Blocking.kt). Each bind permission is the system's alone, so only Android can bind or call them. -->
        <service
            android:name=".BlockService"
            android:exported="true"
            android:label="@string/blocks_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_service" />
        </service>
        <service
            android:name=".BlockListener"
            android:exported="true"
            android:label="@string/blocks_service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".BlockAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/block_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
